# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=
APP_PASSWORD=

# --- Returns classification (all optional; defaults shown) ---
# Results below this confidence are never accepted; they go to the evaluator, then Needs Review.
RETURN_CONFIDENCE_THRESHOLD=0.75
# First pass: reasoning off (fast, cheap). Evaluator: reasoning on (hard cases only).
RETURN_CLASSIFIER_MODEL=sarvam-105b
RETURN_CLASSIFIER_EFFORT=off
RETURN_EVALUATOR_MODEL=sarvam-105b
RETURN_EVALUATOR_EFFORT=low
RETURN_EVALUATOR_MAX_TOKENS=2048
# Two independent fast readings in parallel; a disagreement goes to the evaluator. Doubles the first-pass cost.
RETURN_SECOND_OPINION=off
RETURN_TIMEOUT_S=30

# --- Existing settings (optional) ---
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_LLM_MODEL=sarvam-105b
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=8192
# STT_INR_PER_HOUR=30.00
# LLM_INR_PER_M_INPUT=29.28
# LLM_INR_PER_M_OUTPUT=73.20
# INR_PER_USD=88.0
